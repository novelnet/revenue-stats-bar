# Template for the ChartMogul token file.
#
# Create the real file (do NOT use this example file):
#   mkdir -p ~/.config/revenue-stats-bar
#   printf '%s' 'YOUR_CHARTMOGUL_API_KEY' > ~/.config/revenue-stats-bar/token
#   chmod 600 ~/.config/revenue-stats-bar/token
#
# Find the API key in ChartMogul under: Admin -> API Keys.
# The token file contains only the key on a single line, nothing else.
